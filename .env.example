# ============================================================================
# UIT StudyLab — biến môi trường
# Sao chép thành `.env` (local) và điền giá trị. Trên Vercel, khai báo CÙNG TÊN tại
# Project Settings → Environment Variables. KHÔNG commit file .env chứa secret.
# Chỉ biến có tiền tố NEXT_PUBLIC_ mới được đưa xuống trình duyệt — dự án hiện không dùng biến nào như vậy.
# ============================================================================

# ---------------------------------------------------------------------------
# AI (bắt buộc cho: chấm tự luận, tạo đề thi thử bằng AI). Trắc nghiệm không cần AI.
# ---------------------------------------------------------------------------
# auto (mặc định): dùng OpenAI nếu có OPENAI_API_KEY, ngược lại dùng Gemini nếu có GEMINI_API_KEY. Hoặc ghi rõ: openai | gemini
AI_PROVIDER=auto

# --- Google Gemini (qua endpoint tương thích OpenAI) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_GRADER=
GEMINI_MODEL_GENERATOR=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- OpenAI ---
OPENAI_API_KEY=
# Model mặc định cho mọi tác vụ AI (ví dụ: gpt-4.1-mini). Bắt buộc khi dùng AI.
OPENAI_MODEL=gpt-4.1-mini
# (Tùy chọn) model riêng cho chấm tự luận / tạo đề. Bỏ trống = dùng OPENAI_MODEL.
OPENAI_MODEL_GRADER=
OPENAI_MODEL_GENERATOR=
# (Tùy chọn) endpoint tương thích OpenAI Chat Completions.
OPENAI_BASE_URL=https://api.openai.com/v1
# Thời gian chờ mỗi lượt gọi AI (ms) và số lần thử lại có kiểm soát (0–3).
# Model dự phòng khi model chính hết hạn mức (429) hoặc quá tải (503), cách nhau bởi dấu phẩy.
AI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-2.5-flash
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=1
# Bật bước AI phản biện độc lập cho câu hỏi AI tạo (khuyến nghị: true).
AI_REVIEW_ENABLED=true
# Cho phép AI tạo câu hỏi thi thử. Mặc định false: AI chỉ chấm tự luận, đề thi tạo bằng thuật toán.
AI_EXAM_GENERATION_ENABLED=false

# ---------------------------------------------------------------------------
# Thi thử (bắt buộc cho chế độ Thi thử)
# Khóa bí mật ≥ 32 ký tự để niêm phong đáp án đề thi. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
EXAM_TOKEN_SECRET=
# Số câu AI tạo mới tối đa cho mỗi lần tạo đề (phần còn lại lấy từ pool đã tạo trước).
EXAM_GEN_MAX_NEW_QUESTIONS=24

# ---------------------------------------------------------------------------
# Lưu trữ phía server (khuyến nghị khi deploy Vercel): Upstash Redis
# Dùng cho rate limit, cache kết quả chấm, pool câu hỏi AI, báo lỗi câu hỏi.
# Bỏ trống → dùng bộ nhớ tạm trong tiến trình (chỉ phù hợp local).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Giới hạn chống lạm dụng API
# ---------------------------------------------------------------------------
RATE_LIMIT_ESSAY_PER_MINUTE=6
RATE_LIMIT_ESSAY_PER_DAY=80
RATE_LIMIT_EXAM_PER_HOUR=6
# Tổng số lượt gọi AI tối đa toàn hệ thống mỗi ngày (chặn chi phí bất thường).
RATE_LIMIT_GLOBAL_AI_PER_DAY=2000

# ---------------------------------------------------------------------------
# Quản trị (tùy chọn): bật API /api/admin/pool. Chuỗi bí mật ≥ 16 ký tự.
# ---------------------------------------------------------------------------
ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Dữ liệu minh họa: auto (chỉ hiện khi ngân hàng thật còn trống) | true | false
# ---------------------------------------------------------------------------
ENABLE_DEMO_CONTENT=auto
